# ==============================================================================
# SEEDBOX PILOT — Configuration (.env.example)
# Copiez ce fichier vers .env et renseignez vos identifiants réels.
# Ne commitez JAMAIS votre fichier .env dans Git !
# ==============================================================================

# --- Seedbox Ultra.cc (qBittorrent, Autobrr, Quota JSON) ---
SEEDBOX_BASE_URL=https://apone.ares.usbx.me
QBIT_URL=https://apone.ares.usbx.me/qbittorrent
AUTOBRR_URL=https://apone.ares.usbx.me/autobrr
QUOTA_JSON_URL=https://apone.ares.usbx.me/quota.json

SEEDBOX_USER=apone
SEEDBOX_PASS=CHANGE_ME
AUTOBRR_API_KEY=CHANGE_ME

# --- Tracker 1 : YGGreborn ---
YGG_BASE_URL=https://www.yggreborn.org
YGG_LOGIN=your_email@proton.me
YGG_PASS=CHANGE_ME

# --- Tracker 2 : C411 ---
C411_BASE_URL=https://c411.org
C411_API_KEY=CHANGE_ME

# --- Paramètres de Stratégie & Anti-Hit&Run ---
PILOT_INTERVAL_SEC=300
TRACKER_POLL_INTERVAL_SEC=1800

DISK_HIGH_WATERMARK_PCT=82.0
DISK_LOW_WATERMARK_PCT=75.0
DISK_EMERGENCY_STOP_PCT=92.0

# Règles Hit & Run (avec marge de sécurité de +2h et +0.1 ratio)
C411_MIN_SEED_HOURS=74.0
C411_EXEMPT_RATIO=2.1
YGG_MIN_SEED_HOURS=74.0
YGG_EXEMPT_RATIO=1.5

# Seuils de ratio pour activer les filtres "Hits 2026" (hors Freeleech)
YGG_MIN_RATIO_FOR_PAID=1.10
C411_MIN_RATIO_FOR_PAID=1.00

# --- Serveur Web / Dashboard / API ---
PORT=8080
DATA_DIR=/data
TZ=Europe/Paris
